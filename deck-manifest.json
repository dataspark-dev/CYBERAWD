    {
      "index": 11,
      "file": "slide-11.html",
      "deck_title": "When Attackers Use AI Too",
      "group": "AI & Chatbot Risks",
      "slide_tag": null,
      "eyebrow": "Artificial Intelligence",
      "h1": "WHEN ATTACKERS USE AI TOO",
      "section_lead": [
        "Every AI tool that helps you can also help an attacker. Here's the same four attack types, before and after AI."
      ],
      "cards": [
        {
          "tag": "h3",
          "heading": "Generic Lures",
          "body": "Mass emails with poor writing, sent to thousands of addresses, hoping a few will click."
        },
        {
          "tag": "h3",
          "heading": "One Voice, One Script",
          "body": "A caller stuck with their own accent and a fixed script that doesn't adapt."
        },
        {
          "tag": "h3",
          "heading": "Hand-Written Malware",
          "body": "Code written manually \u2014 slower to make and easier for security tools to detect."
        },
        {
          "tag": "h3",
          "heading": "Manually Forged Paperwork",
          "body": "Hand-crafted fake IDs, invoices, or approval forms \u2014 time-consuming and often has visible errors."
        },
