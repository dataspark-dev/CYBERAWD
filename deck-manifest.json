    {
      "index": 10,
      "file": "slide-10.html",
      "deck_title": "Shadow AI \u2014 Unapproved Tools",
      "group": "AI & Chatbot Risks",
      "slide_tag": null,
      "eyebrow": "Artificial Intelligence",
      "h1": "SHADOW AI \u2014 THE UNAPPROVED TOOLS",
      "section_lead": [
        "Shadow AI \u2014 any AI tool used for work that IT hasn't reviewed or approved. Chatbots aren't the only one."
      ],
      "cards": [
        {
          "tag": "h4",
          "heading": "Browser AI Extensions",
          "body": "Free \"AI assistant\" add-ons read every page you open \u2014 including internal systems. If it isn't approved, remove it."
        },
        {
          "tag": "h4",
          "heading": "Personal AI Accounts",
          "body": "A personal account instead of the company one sits outside our data agreements \u2014 no protection, no oversight."
        },
        {
          "tag": "h4",
          "heading": "AI Meeting Note-Takers",
          "body": "Bots that auto-transcribe send everything said \u2014 including confidential discussion \u2014 to a third-party server."
        },
        {
          "tag": "h4",
          "heading": "Translation & Summariser Plugins",
          "body": "Free \"summarise this doc\" tools upload the whole document to a third-party server \u2014 it then sits outside company control."
        },
        {
          "tag": "h4",
          "heading": "AI Image/Deepfake Generators",
          "body": "Free tools make fake images of colleagues, vessels or documents. GDPR: uploading crew or customer images to a public tool can itself be a breach."
        }
      ],
